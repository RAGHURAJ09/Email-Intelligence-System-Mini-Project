# Backend Environment Variables for Render.com Deployment

# Database (use the connection string from Render dashboard)
DATABASE_URL=postgresql://user:password@your-host.render.com:5432/dbname

# JWT Secret Key (generate a secure key)
JWT_SECRET_KEY=your-super-secret-key-change-this

# Frontend URL (update after deploying frontend)
FRONTEND_URL=https://your-frontend.onrender.com

# Email Configuration
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Optional: Daytona API Key
# DAYTONA_API_KEY=